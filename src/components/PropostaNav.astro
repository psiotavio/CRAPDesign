---
interface Props {
  current: 'ideia' | 'atividade' | 'entrega';
}
const { current } = Astro.props;
const tabs = [
  { key: 'ideia', href: '/proposta', label: 'A ideia' },
  { key: 'atividade', href: '/proposta/atividade', label: 'A atividade' },
  { key: 'entrega', href: '/proposta/entrega', label: 'Implementação e entrega' },
];
---

<nav class="subnav" aria-label="Páginas da proposta">
  {
    tabs.map((t, i) => (
      <a href={t.href} aria-current={current === t.key ? 'page' : undefined}>
        <span class="slug">{i + 1}/3</span>
        {t.label}
      </a>
    ))
  }
</nav>
